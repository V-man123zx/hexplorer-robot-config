Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR PointCloud
      Enabled: true
      Topic:
        Value: /livox/pointcloud
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (Pixels): 3
      Style: Flat Squares
      Color Transformer: Intensity
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: Camera PointCloud
      Enabled: true
      Topic:
        Value: /camera/points
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
      Size (Pixels): 3
      Style: Flat Squares
      Color Transformer: RGB8
      Decay Time: 0
    - Class: rviz_default_plugins/Image
      Name: Camera Color
      Enabled: true
      Topic:
        Value: /camera/color/image_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Camera Depth
      Enabled: true
      Topic:
        Value: /camera/depth/image_raw
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Image
      Name: Tracking Image
      Enabled: true
      Topic:
        Value: /object_tracking/image
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Tracking Markers
      Enabled: true
      Topic:
        Value: /object_tracking/markers
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Object Marker
      Enabled: true
      Topic:
        Value: /object_tracking/marker
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Object Text
      Enabled: true
      Topic:
        Value: /object_tracking/text
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 5
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz_default_plugins)
      Yaw: 0.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1200
