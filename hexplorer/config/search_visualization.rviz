Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Map
      Name: Visited Grid
      Enabled: true
      Topic:
        Value: /object_searcher/visited_grid
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 1.0
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Marker
      Name: Goal Arrow
      Enabled: true
      Topic:
        Value: /object_searcher/goal_marker
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Search Path
      Enabled: true
      Topic:
        Value: /object_searcher/path_marker
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Marker
      Name: Scan Circle
      Enabled: true
      Topic:
        Value: /object_searcher/scan_marker
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR Scan
      Enabled: true
      Topic:
        Value: /livox/lidar
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 0; 255; 0
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR Map
      Enabled: true
      Topic:
        Value: /Laser_map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 1
      Style: Points
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0
      Alpha: 0.6
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered Scan
      Enabled: false
      Topic:
        Value: /cloud_registered
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (Pixels): 2
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 0
      Decay Time: 2
    - Class: rviz_default_plugins/Odometry
      Name: Fast-LIO2 Odometry
      Enabled: true
      Topic:
        Value: /lidar_odometry/pose
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 100
      Shape:
        Value: Arrow
        Alpha: 1
        Axes Length: 0.3
        Axes Radius: 0.03
        Color: 255; 85; 0
        Head Length: 0.1
        Head Radius: 0.05
        Shaft Length: 0.2
        Shaft Radius: 0.03
    - Class: rviz_default_plugins/Image
      Name: Detection View
      Enabled: true
      Topic:
        Value: /object_tracking/image
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Max Value: 1
      Median window: 5
      Min Value: 0
      Normalize Range: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.14
Window Geometry:
  Height: 900
  Width: 1400
  X: 50
  Y: 50
