# Copy to hexplorer/.env and fill in. This file is committed; .env is not.
#
# Every launch script sources this through scripts/common.sh, so the Jetson
# settings only need to live in one place.

# Jetson Orin Nano (sensor machine) SSH login
JETSON_IP=192.168.1.20
JETSON_USER=robot
JETSON_PASS=

# Voice demo only. Can also live in hexplorer/voice/.env if you prefer to keep
# the ElevenLabs keys separate from the robot settings.
# ELEVENLABS_API_KEY=
# AGENT_ID=
